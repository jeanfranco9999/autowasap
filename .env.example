# Copia este archivo como .env y completa tus datos.

# Número de TU celular (la cuenta de WhatsApp que envía los mensajes).
# Formato internacional, solo dígitos, sin "+" ni espacios. Ej. Perú: 51999999999
MY_PHONE=51999999999

# Segundos que se espera siempre después de cada mensaje, aunque el bot responda antes.
REPLY_MIN_WAIT_SECONDS=5

# Segundos máximos que se espera la respuesta del bot.
REPLY_TIMEOUT_SECONDS=90

# Segundos sin mensajes nuevos para considerar que el bot terminó de responder
# (el bot puede responder en varias burbujas).
REPLY_SETTLE_SECONDS=18

# Frases con las que el bot cierra un flujo: al recibirlas ya no se espera más.
REPLY_END_MARKERS=¿Puedo ayudarte en algo más?,Entonces por aquí me quedo
